<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.chatloganalyzer.model.ParticipantSummary,com.chatloganalyzer.util.ViewUtil" %><%List<ParticipantSummary> ps=(List<ParticipantSummary>)request.getAttribute("participants");%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Participants · ChatScope</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a href="${pageContext.request.contextPath}/"><i>⌂</i>Overview</a><a href="${pageContext.request.contextPath}/conversations"><i>◫</i>Conversations</a><a class="active" href="${pageContext.request.contextPath}/participants"><i>◎</i>Participants</a><a href="${pageContext.request.contextPath}/messages/search"><i>⌕</i>Message Explorer</a><p>TOOLS</p><a href="${pageContext.request.contextPath}/import"><i>↥</i>Import Chat</a><a href="${pageContext.request.contextPath}/analytics"><i>◌</i>Analytics</a></nav></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle>☰</button><div><div class="breadcrumb">Workspace / People</div><h1>Participants</h1></div><div class="avatar">CS</div></header><div class="content"><section class="page-head"><div><p class="eyebrow">PEOPLE ANALYTICS</p><h2>The voices behind the conversation.</h2><p>Ranked by message activity across every imported chat.</p></div></section><section class="table-card"><%if(ps.isEmpty()){%><div class="empty-state"><div class="empty-visual">◎</div><h3>No participants yet</h3><p>People will appear here once you import a chat log.</p></div><%}else{%><table class="data-table"><thead><tr><th>Rank</th><th>Participant</th><th>Messages sent</th><th>Words written</th><th>Activity</th></tr></thead><tbody><%int i=0;for(ParticipantSummary p:ps){i++;String n=p.displayName();String initials=n.isBlank()?"?":n.substring(0,Math.min(2,n.length())).toUpperCase();%><tr><td class="rank">#<%=i%></td><td><div class="participant-cell"><span class="initials"><%=ViewUtil.escapeHtml(initials)%></span><b><%=ViewUtil.escapeHtml(n)%></b></div></td><td><%=p.messageCount()%></td><td><%=p.wordCount()%></td><td><span class="source-badge"><%=i==1?"Most active":"Contributor"%></span></td></tr><%}%></tbody></table><%}%></section></div></main></div><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
