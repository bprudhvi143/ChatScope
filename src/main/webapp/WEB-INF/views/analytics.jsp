<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.chatloganalyzer.model.DashboardStats,com.chatloganalyzer.model.AnalyticsData,com.chatloganalyzer.util.ViewUtil" %><%DashboardStats stats=(DashboardStats)request.getAttribute("stats");AnalyticsData a=(AnalyticsData)request.getAttribute("analytics");%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Analytics · ChatScope</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a href="${pageContext.request.contextPath}/"><i>⌂</i>Overview</a><a href="${pageContext.request.contextPath}/conversations"><i>◫</i>Conversations</a><a href="${pageContext.request.contextPath}/participants"><i>◎</i>Participants</a><a href="${pageContext.request.contextPath}/messages/search"><i>⌕</i>Message Explorer</a><p>TOOLS</p><a href="${pageContext.request.contextPath}/import"><i>↥</i>Import Chat</a><a class="active" href="${pageContext.request.contextPath}/analytics"><i>◌</i>Analytics</a></nav></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle>☰</button><div><div class="breadcrumb">Workspace / Insights</div><h1>Analytics</h1></div><div class="avatar">CS</div></header><div class="content"><section class="page-head"><div><p class="eyebrow">FULL ANALYTICS</p><h2>See the rhythm of your chats.</h2><p>Visualized directly from your imported message archive.</p></div></section><section class="metrics"><article><div class="metric-icon indigo">◫</div><div><span>Conversations</span><strong><%=stats.conversationCount()%></strong><small>Archived threads</small></div></article><article><div class="metric-icon blue">✦</div><div><span>Messages</span><strong><%=stats.messageCount()%></strong><small>Total volume</small></div></article><article><div class="metric-icon violet">◎</div><div><span>Participants</span><strong><%=stats.participantCount()%></strong><small>People identified</small></div></article><article><div class="metric-icon coral">⌁</div><div><span>Flagged</span><strong><%=stats.spamCount()%></strong><small>Potential promotions</small></div></article></section><section class="analytics-grid"><article class="card chart-card"><div class="card-head"><div><p class="eyebrow">DAILY TREND</p><h3>Message activity</h3></div></div><div class="chart-wrap"><canvas id="trendChart"></canvas><div class="chart-empty" data-empty="trendChart">No activity yet</div></div></article><article class="card chart-card"><div class="card-head"><div><p class="eyebrow">HOURLY PATTERN</p><h3>When messages arrive</h3></div></div><div class="chart-wrap"><canvas id="hourChart"></canvas><div class="chart-empty" data-empty="hourChart">No activity yet</div></div></article><article class="card chart-card"><div class="card-head"><div><p class="eyebrow">PEOPLE</p><h3>Most active participants</h3></div></div><div class="chart-wrap"><canvas id="peopleChart"></canvas><div class="chart-empty" data-empty="peopleChart">No participant data</div></div></article><article class="card chart-card"><div class="card-head"><div><p class="eyebrow">THREADS</p><h3>Conversation comparison</h3></div></div><div class="chart-wrap"><canvas id="conversationChart"></canvas><div class="chart-empty" data-empty="conversationChart">No conversation data</div></div></article></section></div></main></div><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>const chartData={daily:[<%for(DashboardStats.DailyCount x:a.dailyActivity()){%>{label:"<%=ViewUtil.escapeJson(x.day())%>",value:<%=x.count()%>},<%}%>],hourly:[<%for(DashboardStats.DailyCount x:a.hourlyActivity()){%>{label:"<%=ViewUtil.escapeJson(x.day())%>:00",value:<%=x.count()%>},<%}%>],people:[<%for(AnalyticsData.NamedCount x:a.participants()){%>{label:"<%=ViewUtil.escapeJson(x.name())%>",value:<%=x.count()%>},<%}%>],conversations:[<%for(AnalyticsData.NamedCount x:a.conversations()){%>{label:"<%=ViewUtil.escapeJson(x.name())%>",value:<%=x.count()%>},<%}%>]};</script><script src="${pageContext.request.contextPath}/assets/charts.js"></script><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
