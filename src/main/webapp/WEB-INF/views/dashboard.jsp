<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.chatloganalyzer.model.DashboardStats,com.chatloganalyzer.model.AnalyticsData,com.chatloganalyzer.util.ViewUtil" %>
<% DashboardStats stats=(DashboardStats)request.getAttribute("stats"); AnalyticsData analytics=(AnalyticsData)request.getAttribute("analytics"); %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Overview · Chat Log Analyzer</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=2"></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a class="active" href="${pageContext.request.contextPath}/"><i>⌂</i>Overview</a><a href="${pageContext.request.contextPath}/conversations"><i>◫</i>Conversations</a><a href="${pageContext.request.contextPath}/participants"><i>◎</i>Participants</a><a href="${pageContext.request.contextPath}/messages/search"><i>⌕</i>Message Explorer</a><p>TOOLS</p><a href="${pageContext.request.contextPath}/import"><i>↥</i>Import Chat</a><a href="${pageContext.request.contextPath}/analytics"><i>◌</i>Analytics</a><a href="#"><i>⚙</i>Settings</a></nav><div class="sidebar-bottom"><div class="plan-card"><b>Ready to analyze?</b><span>Import a CSV to unlock insights.</span><a href="${pageContext.request.contextPath}/import">Import chat →</a></div></div></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle aria-label="Toggle navigation">☰</button><div><div class="breadcrumb">Workspace <span>/</span> Overview</div><h1>Good to see you</h1></div><form class="top-search" action="${pageContext.request.contextPath}/messages/search"><span>⌕</span><input name="q" placeholder="Search messages…"></form><div class="top-actions"><button class="icon-button" aria-label="Notifications">♧</button><div class="avatar">CS</div></div></header><div class="content"><section class="intro-row"><div><p class="eyebrow">ANALYTICS OVERVIEW</p><h2>Your communication, <em>in focus.</em></h2><p>Discover conversation patterns and keep the important context close.</p></div><a class="button" href="${pageContext.request.contextPath}/import">↥ Import chat</a></section><section class="metrics"><article><div class="metric-icon indigo">◫</div><div><span>Total conversations</span><strong><%=stats.conversationCount()%></strong><small>Archived chat threads</small></div></article><article><div class="metric-icon blue">✦</div><div><span>Total messages</span><strong><%=stats.messageCount()%></strong><small>Across all imports</small></div></article><article><div class="metric-icon violet">◎</div><div><span>Participants</span><strong><%=stats.participantCount()%></strong><small>Unique people identified</small></div></article><article><div class="metric-icon coral">⌁</div><div><span>Flagged messages</span><strong><%=stats.spamCount()%></strong><small>Potentially promotional</small></div></article></section><section class="dashboard-grid"><article class="card chart-card span-2"><div class="card-head"><div><p class="eyebrow">MESSAGE VOLUME</p><h3>Messages over time</h3></div><span class="pill">Last 30 days</span></div><div class="chart-wrap"><canvas id="trendChart"></canvas><div class="chart-empty" data-empty="trendChart">No message activity yet</div></div></article><article class="card chart-card"><div class="card-head"><div><p class="eyebrow">CONVERSATIONS</p><h3>Distribution</h3></div></div><div class="chart-wrap compact"><canvas id="conversationChart"></canvas><div class="chart-empty" data-empty="conversationChart">No conversations yet</div></div></article><article class="card chart-card"><div class="card-head"><div><p class="eyebrow">PEOPLE</p><h3>Most active</h3></div><a href="${pageContext.request.contextPath}/participants">View all</a></div><div class="chart-wrap"><canvas id="peopleChart"></canvas><div class="chart-empty" data-empty="peopleChart">No participants yet</div></div></article><article class="card quick-card"><p class="eyebrow">QUICK ACTIONS</p><h3>Explore your archive</h3><a href="${pageContext.request.contextPath}/messages/search">Search every message <span>→</span></a><a href="${pageContext.request.contextPath}/conversations">Browse conversations <span>→</span></a><a href="${pageContext.request.contextPath}/analytics">Open full analytics <span>→</span></a></article></section></div></main></div><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>const chartData={daily:[<%for(DashboardStats.DailyCount x:analytics.dailyActivity()){%>{label:"<%=ViewUtil.escapeJson(x.day())%>",value:<%=x.count()%>},<%}%>],people:[<%for(AnalyticsData.NamedCount x:analytics.participants()){%>{label:"<%=ViewUtil.escapeJson(x.name())%>",value:<%=x.count()%>},<%}%>],conversations:[<%for(AnalyticsData.NamedCount x:analytics.conversations()){%>{label:"<%=ViewUtil.escapeJson(x.name())%>",value:<%=x.count()%>},<%}%>]};</script><script src="${pageContext.request.contextPath}/assets/charts.js"></script><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
