<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.chatloganalyzer.model.ConversationSummary,com.chatloganalyzer.util.ViewUtil" %><% List<ConversationSummary> conversations=(List<ConversationSummary>)request.getAttribute("conversations");String flash=(String)request.getAttribute("flash"); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Conversations · ChatScope</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a href="${pageContext.request.contextPath}/"><i>⌂</i>Overview</a><a class="active" href="${pageContext.request.contextPath}/conversations"><i>◫</i>Conversations</a><a href="${pageContext.request.contextPath}/participants"><i>◎</i>Participants</a><a href="${pageContext.request.contextPath}/messages/search"><i>⌕</i>Message Explorer</a><p>TOOLS</p><a href="${pageContext.request.contextPath}/import"><i>↥</i>Import Chat</a><a href="${pageContext.request.contextPath}/analytics"><i>◌</i>Analytics</a></nav></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle>☰</button><div><div class="breadcrumb">Workspace / Archive</div><h1>Conversations</h1></div><form class="top-search" action="${pageContext.request.contextPath}/messages/search"><span>⌕</span><input name="q" placeholder="Search messages…"></form><div class="avatar">CS</div></header><div class="content"><section class="page-head"><div><p class="eyebrow">CONVERSATION ARCHIVE</p><h2>Every discussion, organized.</h2><p><%=conversations.size()%> conversation<%=conversations.size()==1?"":"s"%> in your workspace</p></div><a class="button" href="${pageContext.request.contextPath}/import">↥ Import chat</a></section><%if(flash!=null){%><div class="toast" data-toast><%=ViewUtil.escapeHtml(flash)%></div><%}%><form class="filter-bar"><input aria-label="Search conversations" placeholder="Search conversations"><select aria-label="Source"><option>All sources</option></select><button class="button">Filter</button></form><section class="table-card"><%if(conversations.isEmpty()){%><div class="empty-state"><div class="empty-visual">◫</div><h3>Your archive is ready</h3><p>Import your first CSV to start seeing conversation intelligence.</p><a class="button" href="${pageContext.request.contextPath}/import">Import a chat</a></div><%}else{%><table class="data-table"><thead><tr><th>Conversation</th><th>Source</th><th>Messages</th><th>People</th><th>Last activity</th><th></th></tr></thead><tbody><%for(ConversationSummary c:conversations){%><tr><td class="title-cell"><%=ViewUtil.escapeHtml(c.title())%><span class="subtle">Imported conversation</span></td><td><span class="source-badge"><%=ViewUtil.escapeHtml(c.sourceType())%></span></td><td><%=c.messageCount()%></td><td><%=c.participantCount()%></td><td><%=c.lastActivity()==null?"—":c.lastActivity().toString().replace('T',' ')%></td><td><a class="action-link" href="${pageContext.request.contextPath}/conversation?id=<%=c.id()%>">View →</a></td></tr><%}%></tbody></table><%}%></section></div></main></div><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
