<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.chatloganalyzer.util.ViewUtil" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Import chat · ChatScope</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a href="${pageContext.request.contextPath}/"><i>⌂</i>Overview</a><a href="${pageContext.request.contextPath}/conversations"><i>◫</i>Conversations</a><a href="${pageContext.request.contextPath}/participants"><i>◎</i>Participants</a><a href="${pageContext.request.contextPath}/messages/search"><i>⌕</i>Message Explorer</a><p>TOOLS</p><a class="active" href="${pageContext.request.contextPath}/import"><i>↥</i>Import Chat</a><a href="${pageContext.request.contextPath}/analytics"><i>◌</i>Analytics</a></nav></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle>☰</button><div><div class="breadcrumb">Workspace / Data sources</div><h1>Import chat</h1></div><div class="avatar">CS</div></header><div class="content"><section class="page-head"><div><p class="eyebrow">NEW DATA SOURCE</p><h2>Bring a conversation to life.</h2><p>Upload a CSV and turn raw messages into searchable insight.</p></div></section><%if(request.getAttribute("error")!=null){%><div class="toast" style="background:#fff0f1;color:#b42318"><%=ViewUtil.escapeHtml((String)request.getAttribute("error"))%></div><%}%><div class="upload-layout"><form class="upload-panel" action="${pageContext.request.contextPath}/import" method="post" enctype="multipart/form-data"><label class="drop-zone" data-dropzone><div class="drop-icon">↥</div><strong>Drop your CSV here</strong><span data-file-label>or click to browse · CSV up to 10 MB</span><input type="file" name="chatFile" accept=".csv,text/csv" required></label><button class="button" style="width:100%;margin-top:14px">Import messages</button></form><aside class="upload-panel"><p class="eyebrow">CSV FORMAT</p><h3 style="margin-top:0">A simple, predictable import.</h3><div class="format-list"><div><b>Required columns</b><code>conversation_title,source_type,sender,sent_at,message</code></div><div><b>Timestamp</b><br>Use <code>2026-11-02 14:30</code> or ISO format.</div><div><b>Message text</b><br>Wrap values containing commas in double quotes.</div><a class="action-link" download href="${pageContext.request.contextPath}/sample-chat.csv">↓ Download sample CSV</a></div></aside></div></div></main></div><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
