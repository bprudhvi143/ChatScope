<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.chatloganalyzer.model.Conversation,com.chatloganalyzer.model.Message,com.chatloganalyzer.util.ViewUtil" %><%Conversation c=(Conversation)request.getAttribute("conversation");List<Message> messages=(List<Message>)request.getAttribute("messages");%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=ViewUtil.escapeHtml(c.getTitle())%> · ChatScope</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=2"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a href="${pageContext.request.contextPath}/">⌂ Overview</a><a class="active" href="${pageContext.request.contextPath}/conversations">◫ Conversations</a><a href="${pageContext.request.contextPath}/participants">◎ Participants</a><a href="${pageContext.request.contextPath}/messages/search">⌕ Message Explorer</a></nav></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle>☰</button><div><div class="breadcrumb">Archive / Conversation</div><h1>Conversation</h1></div><div class="avatar">CS</div></header><div class="content"><section class="page-head"><div><p class="eyebrow"><%=ViewUtil.escapeHtml(c.getSourceType())%> IMPORT</p><h2><%=ViewUtil.escapeHtml(c.getTitle())%></h2><p><%=messages.size()%> messages in this conversation</p></div><a class="action-link" href="${pageContext.request.contextPath}/conversations">← All conversations</a></section><section class="message-list"><%for(Message m:messages){String sender=m.getParticipant()==null?"Unknown":m.getParticipant().getDisplayName();String initials=sender.substring(0,Math.min(2,sender.length())).toUpperCase();%><article class="message-card"><div class="message-meta"><span class="initials"><%=ViewUtil.escapeHtml(initials)%></span><b><%=ViewUtil.escapeHtml(sender)%></b><time><%=m.getSentAt().toString().replace('T',' ')%></time></div><p><%=ViewUtil.escapeHtml(m.getBody())%></p></article><%}%></section></div></main></div><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
