<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.chatloganalyzer.model.Message,com.chatloganalyzer.util.ViewUtil" %><%List<Message> messages=(List<Message>)request.getAttribute("messages");String q=(String)request.getAttribute("query");int pageIndex=(Integer)request.getAttribute("page");boolean hasNext=(Boolean)request.getAttribute("hasNext");%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Message Explorer · ChatScope</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">⌁</span><span>chat<span>scope</span><small>ANALYZER</small></span></a><nav class="side-nav"><p>WORKSPACE</p><a href="${pageContext.request.contextPath}/"><i>⌂</i>Overview</a><a href="${pageContext.request.contextPath}/conversations"><i>◫</i>Conversations</a><a href="${pageContext.request.contextPath}/participants"><i>◎</i>Participants</a><a class="active" href="${pageContext.request.contextPath}/messages/search"><i>⌕</i>Message Explorer</a><p>TOOLS</p><a href="${pageContext.request.contextPath}/import"><i>↥</i>Import Chat</a><a href="${pageContext.request.contextPath}/analytics"><i>◌</i>Analytics</a></nav></aside><main class="main"><header class="topbar"><button class="menu-button" data-sidebar-toggle>☰</button><div><div class="breadcrumb">Workspace / Search</div><h1>Message Explorer</h1></div><div class="avatar">CS</div></header><div class="content"><section class="page-head"><div><p class="eyebrow">MESSAGE EXPLORER</p><h2>Find the exact moment.</h2><p>Search safely across the content of every imported conversation.</p></div></section><form class="filter-bar" action="${pageContext.request.contextPath}/messages/search"><input name="q" type="search" value="<%=ViewUtil.escapeHtml(q)%>" placeholder="Search message text" aria-label="Search messages"><button class="button">Search messages</button></form><%if(q.isBlank()){%><div class="empty-state table-card"><div class="empty-visual">⌕</div><h3>Start with a keyword</h3><p>Search by a word or phrase to explore your chat archive.</p></div><%}else if(messages.isEmpty()){%><div class="empty-state table-card"><div class="empty-visual">⌕</div><h3>No messages found</h3><p>Try another phrase or import more conversations.</p></div><%}else{%><section class="message-list"><%for(Message m:messages){String sender=m.getParticipant()==null?"Unknown":m.getParticipant().getDisplayName();String initials=sender.substring(0,Math.min(2,sender.length())).toUpperCase();%><article class="message-card"><div class="message-meta"><span class="initials"><%=ViewUtil.escapeHtml(initials)%></span><b><%=ViewUtil.escapeHtml(sender)%></b><time><%=m.getSentAt().toString().replace('T',' ')%></time></div><p><%=ViewUtil.escapeHtml(m.getBody())%></p><div class="message-ref">◫ <%=ViewUtil.escapeHtml(m.getConversation().getTitle())%></div></article><%}%></section><nav class="pagination"><%if(pageIndex>0){%><a href="?q=<%=java.net.URLEncoder.encode(q,java.nio.charset.StandardCharsets.UTF_8)%>&page=<%=pageIndex-1%>">← Previous</a><%}else{%><span></span><%}%><%if(hasNext){%><a href="?q=<%=java.net.URLEncoder.encode(q,java.nio.charset.StandardCharsets.UTF_8)%>&page=<%=pageIndex+1%>">Next →</a><%}%></nav><%}%></div></main></div><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
